          <span class="ticket-icon">📋</span>
          <div class="ticket-title">
            <strong>男友资格考试</strong>
            <small>ZJ-2026 准考证</small>
          </div>
          <span class="ticket-no">NO.2026</span>
        </div>
        <div class="ticket-divider"></div>
        <div class="ticket-body">
          <div class="row">
            <span class="row-icon">🔖</span>
            <span class="row-label">考试科目</span>
            <span class="row-val">恋爱行为学</span>
          </div>
          <div class="row">
            <span class="row-icon">📝</span>
            <span class="row-label">题型题量</span>
            <span class="row-val">选择题 × 30</span>
          </div>
          <div class="row">
            <span class="row-icon">💯</span>
            <span class="row-label">满分</span>
            <span class="row-val">100 分 <small>（客观 90 + 加分 10）</small></span>
          </div>
          <div class="row">
            <span class="row-icon">⏱️</span>
            <span class="row-label">时长</span>
            <span class="row-val">约 3 分钟</span>
          </div>
          <div class="row row--highlight">
            <span class="row-icon">💳</span>
            <span class="row-label">费用</span>
            <span class="row-val free">免费参加</span>
          </div>
        </div>
        <div class="ticket-stamp">
          <span>准考<br>认证</span>
        </div>
      </div>
    </div>

    <!-- CTA -->
    <button class="cta" ref="ctaRef" @click="$router.push('/quiz')">
      <span class="cta-heart">💘</span>
      <span class="cta-text">开始考试</span>
      <span class="cta-heart">💘</span>
    </button>
    <p class="social-proof" ref="socialProofRef">🔥 已有 <strong>128,439</strong> 位女生参加</p>

    <!-- DEBUG: 快速跳转结果页 -->
    <button class="debug-btn" @click="debugJump">⚡ 快速预览结果</button>

    <!-- 预览卡片 -->
    <div class="preview" ref="previewRef">
      <p class="preview-title">📦 考完你将获得</p>
      <div class="preview-cards">
        <div class="preview-card">🏆<span>等级评定</span></div>
        <div class="preview-card">🏷️<span>男友画像</span></div>
        <div class="preview-card">📸<span>分享卡片</span></div>
      </div>
    </div>

    <p class="note">* 娱乐测试，结果由 AI 生成，别太较真哦～</p>
  </div>
</template>

<script setup>
import { ref, onMounted } from 'vue'
import { useRouter } from 'vue-router'
import gsap from 'gsap'
import FloatingHearts from '../components/FloatingHearts.vue'
import { questions } from '../data/questions.js'

const router = useRouter()

// Refs for GSAP
const chipRef = ref(null)
const titleRef = ref(null)
const descRef = ref(null)
const ticketRef = ref(null)
const ctaRef = ref(null)
const socialProofRef = ref(null)
const previewRef = ref(null)

onMounted(() => {
  // Main entrance timeline
  const tl = gsap.timeline()

  tl.from(chipRef.value, {
    opacity: 0,
    y: -20,
    duration: 0.5,
    ease: 'power3.out'
  })
  .from(titleRef.value, {
    opacity: 0,
    y: 30,
    duration: 0.6,
    ease: 'back.out(1.4)'
  }, '+=0.1')
  .from(descRef.value, {
    opacity: 0,
    duration: 0.4
  }, '+=0.15')
  .from(ticketRef.value, {
    opacity: 0,
    y: 60,
    scale: 0.9,
    duration: 0.7,
    ease: 'back.out(1.2)'
  }, '+=0.15')
  .from(ctaRef.value, {
    opacity: 0,
    y: 40,
    duration: 0.5,
    ease: 'back.out(1.7)'
  }, '+=0.1')
  .from([socialProofRef.value, previewRef.value], {
    opacity: 0,
    y: 20,
    duration: 0.4,
    stagger: 0.1
  }, '+=0.1')

  // CTA hearts pulse
  const hearts = ctaRef.value?.querySelectorAll('.cta-heart')
  if (hearts && hearts.length) {
    hearts.forEach((el, i) => {
      gsap.to(el, {
        scale: 1.22,
        duration: 0.9,
        repeat: -1,
        yoyo: true,
        ease: 'power1.inOut',
        delay: i * 0.6
      })
    })
  }
})

// DEBUG: 全选第一项跳转结果页
function debugJump() {
  const answers = questions.map(q => {
    const opt = q.options[0]
    return { questionId: q.id, score: opt.score, tags: opt.tags || [], text: opt.text }
  })
  const objective = answers.reduce((s, a) => s + a.score, 0)
  const bonus = 5
  router.push({
    path: '/result',
    query: { objective, bonus, total: objective + bonus, answers: JSON.stringify(answers) }
  })
}
</script>

