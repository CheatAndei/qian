<template>
  <div class="home">
    <FloatingHearts :count="6" />

    <!-- Hero 粉色块 -->
    <div class="hero-blob">
      <div class="hero">
        <span class="chip" ref="chipRef">💘 2026 全国统一卷</span>

        <h1 class="title" ref="titleRef">你的男友<br><em>能考几分？</em></h1>

        <p class="desc" ref="descRef">30 道恋爱场景题 · 一键生成分享卡片</p>
      </div>
    </div>

    <!-- 准考证 -->
    <div class="ticket" ref="ticketRef">
